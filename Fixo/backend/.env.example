# FIXO Backend Environment Template
# NEVER commit production credentials, tokens, or usable secrets to source control.
# Generate cryptographically secure random 256-bit keys using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
NODE_ENV=development

# PostgreSQL Connection (Prisma)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://fixo_user:fixo_dev_password@localhost:5432/fixo_dev?schema=public"

# JWT Authentication Keys (MUST be distinct, independent, and at least 32 characters)
# Application startup will fail if these are missing, weak, identical, or match known example defaults.
JWT_ACCESS_SECRET="GENERATE_UNIQUE_RANDOM_ACCESS_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="GENERATE_UNIQUE_RANDOM_REFRESH_SECRET_MIN_32_CHARS"

# Independent HMAC secret for 6-digit OTP phone binding
# Required in production; cryptographically derived in development if omitted.
OTP_HMAC_SECRET="GENERATE_UNIQUE_RANDOM_OTP_HMAC_SECRET_MIN_32_CHARS"

# Telecom SMS Provider Gateway Configuration
# Options: 'DEV_SANDBOX_SMS' (development/test only), 'TWILIO', 'VICTORYLINK', 'VODAFONE_EG'
SMS_PROVIDER_TYPE="DEV_SANDBOX_SMS"

# Development & Sandbox Flags (MUST BE 'false' OR OMITTED IN PRODUCTION)
ALLOW_DEV_SMS="true"
ALLOW_IN_MEMORY_FALLBACK="true"
ENABLE_DEMO_SEED="true"
