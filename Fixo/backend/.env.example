# FIXO Backend Environment Template
# NEVER commit production credentials, tokens, or usable secrets to source control.
# Generate cryptographically secure random 256-bit keys using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
NODE_ENV=development

# PostgreSQL Connection (Prisma)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://fixo_user:fixo_dev_password@localhost:5432/fixo_dev?schema=public"
TEST_DATABASE_URL="postgresql://fixo_user:fixo_dev_password@localhost:5432/fixo_test?schema=public"

# JWT Authentication Keys (MUST be distinct, independent, and at least 32 characters)
# Application startup will fail if these are missing, weak, identical, or match known example defaults.
JWT_ACCESS_SECRET="GENERATE_UNIQUE_RANDOM_ACCESS_SECRET_MIN_32_CHARS"
JWT_REFRESH_SECRET="GENERATE_UNIQUE_RANDOM_REFRESH_SECRET_MIN_32_CHARS"

# Independent HMAC secret for 6-digit OTP phone binding
# Required in production; cryptographically derived in development if omitted.
OTP_HMAC_SECRET="GENERATE_UNIQUE_RANDOM_OTP_HMAC_SECRET_MIN_32_CHARS"

# Telecom SMS Provider Gateway Configuration
# Options: 'DEV_SANDBOX_SMS' (development/test only), 'TWILIO', 'VICTORYLINK', 'VODAFONE_EG'
SMS_PROVIDER_TYPE="DEV_SANDBOX_SMS"

# Development & Sandbox Flags (MUST BE 'false' OR OMITTED IN PRODUCTION)
ALLOW_DEV_SMS="true"
ALLOW_IN_MEMORY_FALLBACK="true"
ENABLE_DEMO_SEED="true"

# Verified email/Google sign-in. Production may use SMS_PROVIDER_TYPE=DISABLED
# only when a real FIREBASE_PROJECT_ID is set. Never enable sandbox flags publicly.
FIREBASE_PROJECT_ID=""
# Public Firebase Web API key used only for the server's password-auth gateway.
FIREBASE_WEB_API_KEY=""
# Optional FCM sender JSON: server-only, never include it in Flutter or Git.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Public Web Push VAPID key; generated under Firebase Cloud Messaging settings.
FIREBASE_WEB_VAPID_KEY=""
FIXO_APNS_CONFIGURED="false"
# Keep false until APNs key/profile and real iOS delivery are verified.

# Isolated Clerk trial. Existing Firebase/phone login remains the default.
# Enable only after the private identity-link migration and dual-proof client trial.
CLERK_TRIAL_ENABLED="false"
CLERK_ISSUER=""
CLERK_AUTHORIZED_PARTIES=""
CLERK_JWT_KEY=""
# Server-only Clerk key; never put it in Flutter, public env vars, Git or chat.
CLERK_SECRET_KEY=""
DATABASE_CONNECT_TIMEOUT_MS="10000"

# Server-only private media storage. Never bundle the secret in Flutter/admin.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
